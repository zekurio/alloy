{
  "name": "alloy",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm db:push && turbo run dev --filter=@alloy/server --filter=@alloy/web",
    "dev:all": "pnpm db:push && turbo run dev --filter=@alloy/server --filter=@alloy/web --filter=@alloy/desktop",
    "dev:server": "pnpm db:push && turbo run dev --filter=@alloy/server",
    "dev:web": "turbo run dev --filter=@alloy/web",
    "recorder:build": "pnpm --filter @alloy/desktop build:recorder",
    "recorder:build:release": "pnpm --filter @alloy/desktop build:recorder:release",
    "desktop:obs:install": "pnpm --filter @alloy/desktop obs:install",
    "tauri:dev": "pnpm --filter @alloy/desktop dev",
    "tauri:build": "pnpm --filter @alloy/desktop build:app",
    "tauri:dist:win:installer": "pnpm --filter @alloy/desktop dist:win:installer",
    "start": "pnpm --filter @alloy/server start",
    "db:generate": "pnpm --filter @alloy/db db:generate",
    "db:migrate": "pnpm --filter @alloy/db db:migrate",
    "db:push": "pnpm --filter @alloy/db db:push",
    "db:studio": "pnpm --filter @alloy/db db:studio",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:github": "pnpm lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "verify": "pnpm fmt:check && pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "@types/node": "26.5.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
