{
  "name": "alloy",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm db:push && pnpm --parallel --filter @alloy/server --filter @alloy/web dev",
    "dev:all": "pnpm db:push && pnpm --parallel --filter @alloy/server --filter @alloy/web --filter @alloy/desktop dev",
    "dev:server": "pnpm db:push && pnpm --filter @alloy/server dev",
    "dev:web": "pnpm --filter @alloy/web dev",
    "desktop:obs:install": "pnpm --filter @alloy/desktop obs:install",
    "desktop:dev": "pnpm --filter @alloy/desktop dev",
    "desktop:build": "pnpm --filter @alloy/desktop build:app",
    "desktop:dist:win:installer": "pnpm --filter @alloy/desktop dist:win:installer",
    "start": "pnpm --filter @alloy/server start",
    "db:generate": "pnpm --filter @alloy/db db:generate",
    "db:migrate": "pnpm --filter @alloy/db db:migrate",
    "db:push": "pnpm --filter @alloy/db db:push",
    "db:studio": "pnpm --filter @alloy/db db:studio",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint && pnpm --filter @alloy/i18n check:catalogs",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tools/oxlint",
    "verify": "pnpm fmt:check && pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/node": "26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
