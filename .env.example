# Local development environment template. Copy to `.env` in the repository
# root; the devenv shell does that on first entry with generated secrets and
# exports its own DATABASE_URL and storage paths on top. Variables already set
# in the shell are never overridden. This file is the single documented
# template for the server.
# Do not copy it to packages/server/.env: the server loads the nearest `.env`
# walking up from its working directory and stops at the first one it finds, so
# a packages/server/.env would shadow the root file entirely.

# Postgres for non-devenv local development. Point this at your local instance.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/alloy

# Server defaults (see packages/server/src/env.ts). In production
# PUBLIC_SERVER_URL must be the externally reachable https origin, not a
# loopback address.
PORT=2552
PUBLIC_SERVER_URL=http://localhost:2552
# Unix socket alternative for DATABASE_URL:
# postgres://postgres@localhost/alloy?host=/var/run/postgresql

# Directory of the built web app served by the API server (packaged builds).
# WEB_DIST_DIR=../web/dist
# Directory of Drizzle migrations to apply on start (set by the Nix package).
# ALLOY_MIGRATIONS_DIR=
# Set to "json" for structured JSON logs; anything else logs human-readable.
# LOG_FORMAT=json

# Required internal signing secrets. Use unique random 32+ character values.
ALLOY_VIEWER_COOKIE_SECRET=dev-viewer-cookie-secret-32-bytes-min
ALLOY_UPLOAD_HMAC_SECRET=dev-upload-hmac-secret-32-bytes-min

# Allow the Vite dev server origin to call the API.
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse proxies allowed to report the client address via X-Forwarded-For,
# as comma-separated IPs or CIDR ranges. Rate limits and session IPs use the
# right-most address not listed here. Unset trusts no proxy, so every request
# is keyed on its socket address; behind a proxy, list the proxy's address.
# ALLOY_TRUSTED_PROXIES=127.0.0.1,::1

# Admin settings: the next five groups, through encoding. Each variable sets
# a default. The server starts from its built-in value, applies the variable,
# and then applies any value an admin saved in the admin settings. A saved
# value wins until the admin resets it, which hands the setting back to the
# variable. The server logs each variable that a saved value overrides.

# Sign-in. Server defaults: open registrations off, passkeys on, sign-in
# required to browse. Open registrations covers passkey sign-up only; single
# sign-on decides for itself with ALLOY_OIDC_ALLOW_SIGN_UP.
# ALLOY_OPEN_REGISTRATIONS=false
# ALLOY_PASSKEY_ENABLED=true
# ALLOY_REQUIRE_AUTH_TO_BROWSE=true

# Single sign-on through one OpenID Connect provider. Register
# $PUBLIC_SERVER_URL/api/auth/oauth2/callback/oidc as its redirect URI.
# The issuer URL may also be the full URL of the discovery document. Set
# ALLOY_OIDC_CLIENT_SECRET_FILE instead of ALLOY_OIDC_CLIENT_SECRET to read
# the secret from a file.
# ALLOY_OIDC_ENABLED=true
# ALLOY_OIDC_DISPLAY_NAME=Pocket ID
# ALLOY_OIDC_ISSUER_URL=https://auth.example.com
# ALLOY_OIDC_CLIENT_ID=
# ALLOY_OIDC_CLIENT_SECRET=
# ALLOY_OIDC_SCOPES=openid profile email
# ALLOY_OIDC_ALLOW_SIGN_UP=false
# Less common provider settings; the defaults suit most providers. Without an
# issuer URL, set the authorization and token URLs, plus the user info URL
# unless ALLOY_OIDC_FETCH_USERINFO is false.
# ALLOY_OIDC_AUTHORIZATION_URL=
# ALLOY_OIDC_TOKEN_URL=
# ALLOY_OIDC_USERINFO_URL=
# ALLOY_OIDC_TOKEN_AUTH_METHOD=client_secret_post
# ALLOY_OIDC_PKCE=true
# ALLOY_OIDC_FETCH_USERINFO=true
# ALLOY_OIDC_AUTH_PARAMS={"prompt":"consent"}
# ALLOY_OIDC_UID_CLAIM=sub
# ALLOY_OIDC_USERNAME_CLAIM=preferred_username
# ALLOY_OIDC_AVATAR_CLAIM=picture
# ALLOY_OIDC_QUOTA_CLAIM=alloy_quota
# ALLOY_OIDC_ROLE_CLAIM=alloy_role

# Appearance. Accents are #rrggbb per appearance; unset keeps Alloy's own.
# ALLOY_ACCENT_COLOR_LIGHT=#3b5bdb
# ALLOY_ACCENT_COLOR_DARK=#6d8cf5
# ALLOY_LOGIN_SPLASH_ENABLED=false
# ALLOY_LOGIN_SPLASH_BLUR_PX=24
# ALLOY_LOGIN_SPLASH_DARKEN_OPACITY=0.8

# Limits. An unset storage quota means unlimited. The upload TTL is how long a
# clip upload has to finish, in seconds (60 to 86400).
# ALLOY_DEFAULT_STORAGE_QUOTA_BYTES=
ALLOY_UPLOAD_TTL_SEC=900
# ALLOY_UPLOAD_SCREENSHOT_MAX_BYTES=52428800
# ALLOY_UPLOAD_SCREENSHOT_MAX_PIXELS=64000000
# ALLOY_UPLOAD_AVATAR_MAX_BYTES=5242880
# ALLOY_UPLOAD_BANNER_MAX_BYTES=10485760
# ALLOY_UPLOAD_GAME_ASSET_MAX_BYTES=10485760

# Encoding of new clips. Codecs: h264, hevc, av1. Hardware acceleration:
# none, nvenc, qsv, vaapi, videotoolbox. Quality is CRF-scale (10 to 51, lower
# is better). Tiers are a JSON array of {height, maxFps, maxrateKbps} with an
# optional codec, and og: true on the tier used for link previews.
# ALLOY_TRANSCODE_VIDEO_CODEC=h264
# ALLOY_TRANSCODE_HARDWARE_ACCELERATION=none
# ALLOY_TRANSCODE_VAAPI_DEVICE=/dev/dri/renderD128
# ALLOY_TRANSCODE_QUALITY=22
# ALLOY_TRANSCODE_AUDIO_BITRATE_KBPS=128
# ALLOY_TRANSCODE_TIERS=[{"height":1080,"maxFps":60,"maxrateKbps":8000,"og":true},{"height":720,"maxFps":60,"maxrateKbps":5000}]

# Filesystem storage.
ALLOY_STORAGE_FS_CLIPS_PATH=../../data/storage/clips
ALLOY_STORAGE_FS_THUMBNAILS_PATH=../../data/storage/thumbnails
ALLOY_STORAGE_FS_ASSETS_PATH=../../data/storage/assets

# Transcoding (renditions + HLS). ffmpeg must be on PATH or named explicitly.
# When unset, Alloy auto-detects common jellyfin-ffmpeg installs before PATH.
# jellyfin-ffmpeg is recommended for hardware-accelerated encoders.
# ALLOY_FFMPEG_PATH=ffmpeg
# ffprobe binary; defaults to the one next to ALLOY_FFMPEG_PATH, else PATH.
# ALLOY_FFPROBE_PATH=ffprobe
# Clips encoding concurrently; each ffmpeg already uses all cores.
# ALLOY_TRANSCODE_CONCURRENCY=1
# x264 threads per encode; 0 = auto (all cores).
# ALLOY_TRANSCODE_THREADS=0

# Required. Game search, artwork, and canonical game names come from
# SteamGridDB: https://www.steamgriddb.com/profile/preferences/api
ALLOY_STEAMGRIDDB_API_KEY=replace-me

# OAuth avatar sync refuses provider avatar URLs that resolve to private or
# loopback addresses (SSRF guard) and does not follow redirects. Set to true
# only when a self-hosted LAN IdP serves avatars from the private network.
# ALLOY_OAUTH_AVATAR_ALLOW_PRIVATE_URLS=false

# Web-only variables are NOT read from this file. `pnpm dev:web` runs Vite from
# packages/web, so VITE_SERVER_URL (API proxy target, default
# http://localhost:2552) belongs in packages/web/.env; see
# packages/web/.env.example.
