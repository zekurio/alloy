{
  "name": "@alloy/server",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "vp build",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "pnpm --filter @alloy/db db:generate",
    "db:migrate": "pnpm --filter @alloy/db db:migrate",
    "db:push": "pnpm --filter @alloy/db db:push",
    "db:studio": "pnpm --filter @alloy/db db:studio"
  },
  "dependencies": {
    "@alloy/contracts": "workspace:*",
    "@alloy/db": "workspace:*",
    "@alloy/env": "workspace:*",
    "@alloy/logging": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@simplewebauthn/server": "13.3.3",
    "blurhash": "2.0.5",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "openid-client": "6.8.7",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "typebox": "1.3.23"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "vite": "catalog:"
  }
}
