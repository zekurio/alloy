{
  "name": "@alloy/server",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "vite build",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_ENV=production node --max-semi-space-size=8 dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "pnpm --filter @alloy/db db:generate",
    "db:migrate": "pnpm --filter @alloy/db db:migrate",
    "db:push": "pnpm --filter @alloy/db db:push",
    "db:studio": "pnpm --filter @alloy/db db:studio"
  },
  "dependencies": {
    "@alloy/contracts": "workspace:*",
    "@alloy/db": "workspace:*",
    "@alloy/env": "workspace:*",
    "@alloy/i18n": "workspace:*",
    "@alloy/logging": "workspace:*",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.5",
    "@simplewebauthn/server": "14.0.3",
    "blurhash": "2.0.5",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typebox": "1.4.2",
    "vite": "catalog:"
  }
}
