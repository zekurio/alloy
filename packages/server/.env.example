# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alloy
# Unix socket example:
# DATABASE_URL=postgres://postgres@localhost/alloy?host=/var/run/postgresql

# Local server. In production this must be the externally reachable origin,
# not localhost or a loopback address.
PUBLIC_SERVER_URL=http://localhost:2552
PORT=2552

# Required internal signing secrets. Use unique random 32+ character values.
ALLOY_VIEWER_COOKIE_SECRET=dev-viewer-cookie-secret-32-bytes-min
ALLOY_UPLOAD_HMAC_SECRET=dev-upload-hmac-secret-32-bytes-min

# Packaged web build override
# WEB_DIST_DIR=../web/dist
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth policy. Managed in the admin settings UI by default; setting a variable
# here makes it env-managed and locks its admin UI control. Server defaults:
# open registrations off, passkeys on, sign-in required to browse.
# ALLOY_OPEN_REGISTRATIONS=false
# ALLOY_PASSKEY_ENABLED=true
# ALLOY_REQUIRE_AUTH_TO_BROWSE=true
# ALLOY_DEFAULT_STORAGE_QUOTA_BYTES=
ALLOY_UPLOAD_TTL_SEC=900

# Filesystem storage.
ALLOY_STORAGE_FS_CLIPS_PATH=../../data/storage/clips
ALLOY_STORAGE_FS_THUMBNAILS_PATH=../../data/storage/thumbnails
ALLOY_STORAGE_FS_ASSETS_PATH=../../data/storage/assets

# Required. Game search, artwork, and canonical game names come from
# SteamGridDB: https://www.steamgriddb.com/profile/preferences/api
ALLOY_STEAMGRIDDB_API_KEY=replace-me

# Optional OIDC configuration. OAuth providers are managed in the admin
# settings UI by default; setting ALLOY_SOCIALACCOUNT_PROVIDERS makes the
# provider list env-managed and locks the admin UI section. Browser pages never
# load provider icons from external origins. Env-managed external icon_url
# values are withheld; admin-managed providers ingest icon URLs into Alloy's
# own storage instead.
# ALLOY_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"SCOPE":["openid","identify","email"],"OAUTH_PKCE_ENABLED":true,"APPS":[{"provider_id":"discord","name":"Discord","client_id":"alloy","secret":"replace-me","settings":{"server_url":"https://discord.com","username_claim":"username","button_color":"#5865F2","button_text_color":"#ffffff"}}]}}
