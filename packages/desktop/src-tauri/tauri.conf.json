{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alloy",
  "version": "0.0.8",
  "identifier": "dev.zekurio.alloy",
  "build": {
    "beforeDevCommand": "pnpm build:renderer",
    "beforeBuildCommand": "pnpm build:renderer",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/zekurio/alloy/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["connect"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "../../../public/logo.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
