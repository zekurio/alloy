{
  "name": "@alloy/desktop",
  "version": "0.0.8",
  "private": true,
  "description": "Alloy desktop app",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-native.mjs && tauri dev",
    "obs:install": "node scripts/install-obs-runtime.mjs",
    "build:recorder": "node scripts/build-agent.mjs",
    "build:recorder:release": "node scripts/build-agent.mjs --release --require-obs-runtime",
    "build:app": "node scripts/prepare-native.mjs --release && tauri build --no-bundle",
    "dist:win:installer": "node scripts/prepare-native.mjs --release && tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "check:native": "cargo fmt --package alloy-desktop --check && cargo clippy --package alloy-desktop --all-targets --locked -- -D warnings",
    "test:native": "cargo test --package alloy-desktop --all-targets --locked",
    "dist:win:installer:signed": "pnpm dist:win:installer --config src-tauri/tauri.signed.conf.json"
  },
  "dependencies": {
    "@alloy/desktop-contracts": "workspace:*",
    "@alloy/i18n": "workspace:*",
    "@alloy/ui": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1"
  }
}
