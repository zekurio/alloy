{
  "name": "@alloy/desktop",
  "version": "0.0.19",
  "private": true,
  "description": "Alloy desktop app",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/prepare-native.mjs && node scripts/build-addon.mjs && install-electron && electron-vite dev --watch",
    "obs:install": "node scripts/install-obs-runtime.mjs",
    "build:recorder": "node scripts/build-agent.mjs",
    "build:recorder:release": "node scripts/build-agent.mjs --release --require-obs-runtime",
    "build:addon": "node scripts/build-addon.mjs",
    "build:shell": "electron-vite build",
    "build:app": "node scripts/prepare-native.mjs --release && node scripts/build-addon.mjs --release && pnpm build:shell",
    "dist:win:installer": "pnpm build:app && electron-builder --win nsis --x64 --publish never",
    "start": "install-electron && electron-vite preview",
    "typecheck": "tsc --noEmit",
    "check:native": "cargo fmt --package alloy-desktop --package alloy-desktop-native --check && cargo clippy --package alloy-desktop --package alloy-desktop-native --all-targets --locked -- -D warnings",
    "test:native": "cargo test --package alloy-desktop --all-targets --locked"
  },
  "devDependencies": {
    "@alloy/contracts": "workspace:*",
    "@alloy/i18n": "workspace:*",
    "@alloy/primitives": "workspace:*",
    "@alloy/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "catalog:",
    "zod": "4.6.7"
  }
}
